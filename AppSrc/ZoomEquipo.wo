// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomEquipo.wo
// ZoomEquipo
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use sql.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Object oZoomEquipo is a cWebView
    Set piColumnCount to 12
    Set psCaption to "ZoomEquipo"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Set Main_DD To oequipo_DD
    Set Server  To oequipo_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4 
        
         Object oNombreEquipoGroup is a cWebGroup
            Set psCSSClass to "BordesRedondeados"

            Object oequipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 5
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Equipo"
            End_Object  
            
            Object oBtnContratarEntrenador is a cWebButton
                Set piColumnSpan to 0
                Set psCaption to "Contratar Entrenador"
                Set psCSSClass to "WebButton"

                WebRegisterPath ntNavigateForward oSelectEntrenador

                Procedure OnClick
                    Send NavigatePath
                End_Procedure

                // Forzamos nfFromMain para que SelectEntrenador muestre todos los entrenadores
                // y al hacer clic nos devuelva el seleccionado en OnNavigateBack
                Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                    Move nfFromMain to NavigateData.eNavigateType
                End_Procedure
            End_Object
            
         End_Object
         
         Object oLigaNombreGroup is a cWebGroup
            Set psCSSClass to "BordesRedondeados"

            Object oligaNombre is a cWebForm
                Entry_Item liga.Nombre
                Set piColumnSpan to 7
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Liga"
                Set pbPromptButton to True
    
                WebRegisterPath ntNavigateForward oSelectLiga
    
                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object
            
            Object oBtnVerLiga is a cWebButton
                Set piColumnSpan to 0
                Set psCaption to "Ver detalles de esta Liga"
                Set psCSSClass to "WebButton"
                
                WebRegisterPath ntNavigateForward oZoomLiga
                
                Procedure OnClick
                    Send NavigatePath
                End_Procedure
            End_Object
        
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    // Comprueba en MySQL si el equipo actual ya tiene un entrenador asignado
    Function TieneEntrenador Integer iEquipoID Returns Boolean
        Handle hoSQLMngr hdbc hstmt
        Integer iFetchResult
        Boolean bTiene

        Move False to bTiene
        If (iEquipoID > 0) Begin
            Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
            Get SQLFileConnect of hoSQLMngr equipo.File_number to hdbc
            Get SQLOpen of hdbc to hstmt
            Send SQLExecDirect of hstmt ("SELECT ID FROM entrenador WHERE EquipoID = " + String(iEquipoID) + " LIMIT 1")
            Get SQLFetch of hstmt to iFetchResult
            If (iFetchResult <> 0) Begin
                Move True to bTiene
            End
            Send SQLClose of hstmt
            Send SQLDisconnect of hdbc
            Send Destroy of hoSQLMngr
        End

        Function_Return bTiene
    End_Function

    // Se ejecuta cuando el usuario elige un entrenador en SelectEntrenador
    Procedure OnNavigateBack tWebNavigateData NavigateData Integer hoClosedView
        Handle hoSQLMngr hdbc hstmt
        Integer iEquipoID iEntrenadorID

        If (hoClosedView = oSelectEntrenador) Begin
            Get Field_Current_Value of oequipo_DD Field equipo.ID to iEquipoID
            Get Field_Current_Value of (Main_DD(hoClosedView)) Field entrenador.ID to iEntrenadorID

            If (iEquipoID > 0 and iEntrenadorID > 0) Begin
                Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
                Get SQLFileConnect of hoSQLMngr equipo.File_number to hdbc
                Get SQLOpen of hdbc to hstmt

                // 1. Por seguridad, si el equipo tenía entrenador, pasa a estar libre
                Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = NULL WHERE EquipoID = " + String(iEquipoID))
                // 2. Asignamos el nuevo entrenador a este equipo
                Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = " + String(iEquipoID) + " WHERE ID = " + String(iEntrenadorID))

                Send SQLClose of hstmt
                Send SQLDisconnect of hdbc
                Send Destroy of hoSQLMngr

                // Actualizamos los botones para que "Contratar Entrenador" se oculte
                Send SetActionButtons
            End
        End
    End_Procedure

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord bTieneEntrenador
        Integer iEquipoID
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End

        // Solo mostramos el botón si el equipo existe y NO tiene entrenador
        Move False to bTieneEntrenador
        If (bHasRecord) Begin
            Get Field_Current_Value of oequipo_DD Field equipo.ID to iEquipoID
            Get TieneEntrenador iEquipoID to bTieneEntrenador
        End
        WebSet pbRender of oBtnContratarEntrenador to (bHasRecord and not(bTieneEntrenador))
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        // Si venimos directamente desde oZoomLiga, ocultamos el botón para evitar el error de pila
        If (hoInvokingView = oZoomLiga) Begin
            WebSet pbRender of oBtnVerLiga to False
        End
        Else Begin
            WebSet pbRender of oBtnVerLiga to True
        End
    
        Send SetActionButtons
    End_Procedure

End_Object 
