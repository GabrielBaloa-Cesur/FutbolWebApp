37632>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37635>>>        Case Begin
37635>>>            Case (NavigateData.eNavigateType = nfFromMain)
37637>>>                // If from main, this is a propbably a main file Select to Zoom.
37637>>>                Case Break
37638>>>
37638>>>            Case (NavigateData.eNavigateType = nfFromParent)
37641>>>                // If from parent, this is a constrained drill down.
37641>>>                Case Break
37642>>>
37642>>>            Case (NavigateData.eNavigateType = nfFromChild)
