38974>>>                // If from main, this is a probably a main-file lookup from a Zoom
38974>>>                WebSet pbRender of oDetailButton to False
38975>>>                Case Break
38976>>>
38976>>>            Case Else // must be nfUndefined
38976>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38976>>>                // If Row select does main-zoom we don't need this
38976>>>                WebSet pbRender of oDetailButton to False
38977>>>
38977>>>        Case End
38977>>>
