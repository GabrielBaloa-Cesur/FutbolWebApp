39066>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39066>>>                Case Break
39067>>>
39067>>>            Case Else // must be nfUndefined
39067>>>
39067>>>        Case End
39067>>>
39067>>>        Send SetActionButtons
