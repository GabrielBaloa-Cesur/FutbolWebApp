37679>>>>>
37679>>>>>    // Comprueba en MySQL si el equipo actual ya tiene un entrenador asignado
37679>>>>>    Function TieneEntrenador Integer iEquipoID Returns Boolean
37682>>>>>        Handle hoSQLMngr hdbc hstmt
37682>>>>>        Integer iFetchResult
37682>>>>>        Boolean bTiene
37682>>>>>
37682>>>>>        Move False to bTiene
37683>>>>>        If (iEquipoID > 0) Begin
37685>>>>>            Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
37686>>>>>            Get SQLFileConnect of hoSQLMngr equipo.File_number to hdbc
37687>>>>>            Get SQLOpen of hdbc to hstmt
37688>>>>>            Send SQLExecDirect of hstmt ("SELECT ID FROM entrenador WHERE EquipoID = " + String(iEquipoID) + " LIMIT 1")
37689>>>>>            Get SQLFetch of hstmt to iFetchResult
37690>>>>>            If (iFetchResult <> 0) Begin
37692>>>>>                Move True to bTiene
37693>>>>>            End
37693>>>>>>
37693>>>>>            Send SQLClose of hstmt
37694>>>>>            Send SQLDisconnect of hdbc
37695>>>>>            Send Destroy of hoSQLMngr
37696>>>>>        End
37696>>>>>>
37696>>>>>
37696>>>>>        Function_Return bTiene
37697>>>>>    End_Function
37698>>>>>
37698>>>>>    // Se ejecuta cuando el usuario elige un entrenador en SelectEntrenador
37698>>>>>    Procedure OnNavigateBack tWebNavigateData NavigateData Integer hoClosedView
37701>>>>>        Handle hoSQLMngr hdbc hstmt
37701>>>>>        Integer iEquipoID iEntrenadorID
37701>>>>>
37701>>>>>        If (hoClosedView = oSelectEntrenador) Begin
37703>>>>>            Get Field_Current_Value of oequipo_DD Field equipo.ID to iEquipoID
37704>>>>>            Get Field_Current_Value of (Main_DD(hoClosedView)) Field entrenador.ID to iEntrenadorID
37705>>>>>
37705>>>>>            If (iEquipoID > 0 and iEntrenadorID > 0) Begin
37707>>>>>                Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
37708>>>>>                Get SQLFileConnect of hoSQLMngr equipo.File_number to hdbc
37709>>>>>                Get SQLOpen of hdbc to hstmt
37710>>>>>
37710>>>>>                // 1. Por seguridad, si el equipo tenía entrenador, pasa a estar libre
37710>>>>>                Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = NULL WHERE EquipoID = " + String(iEquipoID))
37711>>>>>                // 2. Asignamos el nuevo entrenador a este equipo
37711>>>>>                Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = " + String(iEquipoID) + " WHERE ID = " + String(iEntrenadorID))
37712>>>>>
37712>>>>>                Send SQLClose of hstmt
37713>>>>>                Send SQLDisconnect of hdbc
37714>>>>>                Send Destroy of hoSQLMngr
37715>>>>>
37715>>>>>                // Actualizamos los botones para que "Contratar Entrenador" se oculte
37715>>>>>                Send SetActionButtons
37716>>>>>            End
37716>>>>>>
37716>>>>>        End
37716>>>>>>
37716>>>>>    End_Procedure
37717>>>>>
37717>>>>>    Procedure SetActionButtons
37720>>>>>        tWebNavigateData NavigateData
37720>>>>>        tWebNavigateData NavigateData
37720>>>>>        Boolean bHasRecord bTieneEntrenador
37720>>>>>        Integer iEquipoID
37720>>>>>        Handle hoDD
37720>>>>>
37720>>>>>        Get Server to hoDD
37721>>>>>        Get GetNavigateData to NavigateData
37722>>>>>        Get HasRecord of hoDD to bHasRecord
37723>>>>>
37723>>>>>        WebSet pbRender of oEditBtn to False
37724>>>>>        WebSet pbRender of oSaveBtn to False
37725>>>>>        WebSet pbRender of oCancelChangesBtn to False
37726>>>>>        WebSet pbRender of oDeleteBtn to False
37727>>>>>
37727>>>>>        If (NavigateData.bReadOnly) Begin
37729>>>>>            WebSet pbRender of oEditBtn to True
37730>>>>>        End
37730>>>>>>
37730>>>>>        Else Begin
37731>>>>>            WebSet pbRender of oSaveBtn to True
37732>>>>>            WebSet pbRender of oCancelChangesBtn to True
37733>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37734>>>>>        End
37734>>>>>>
37734>>>>>
37734>>>>>        // Solo mostramos el botón si el equipo existe y NO tiene entrenador
37734>>>>>        Move False to bTieneEntrenador
37735>>>>>        If (bHasRecord) Begin
37737>>>>>            Get Field_Current_Value of oequipo_DD Field equipo.ID to iEquipoID
37738>>>>>            Get TieneEntrenador iEquipoID to bTieneEntrenador
37739>>>>>        End
37739>>>>>>
37739>>>>>        WebSet pbRender of oBtnContratarEntrenador to (bHasRecord and not(bTieneEntrenador))
37740>>>>>    End_Procedure
