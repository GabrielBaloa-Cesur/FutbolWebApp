38939>>>        Get GetNavigateData to NavigateData
38940>>>        Get HasRecord of hoDD to bHasRecord
38941>>>
38941>>>        // let's hide all buttons and then Show the ones we want
38941>>>        WebSet pbRender of oEditBtn to False
38942>>>        WebSet pbRender of oSaveBtn to False
38943>>>        WebSet pbRender of oCancelChangesBtn to False
38944>>>        WebSet pbRender of oDeleteBtn to False
38945>>>
38945>>>        If (NavigateData.bReadOnly) Begin
38947>>>            WebSet pbRender of oEditBtn to True
38948>>>        End
38948>>>>
38948>>>        Else Begin
38949>>>            WebSet pbRender of oSaveBtn to True
38950>>>            WebSet pbRender of oCancelChangesBtn to True
38951>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38952>>>        End
38952>>>>
38952>>>    End_Procedure
