38565>>>        Procedure Request_Save
38568>>>            Handle hoSQLMngr hdbc hstmt
38568>>>            Integer iEntrenadorID iEquipoID
38568>>>
38568>>>            Get Field_Current_Value Field entrenador.ID to iEntrenadorID
38569>>>            Get Field_Current_Value of oequipo_DD Field equipo.ID to iEquipoID
38570>>>
38570>>>            // Si hay un equipo asignado, pasamos a NULL a cualquier otro entrenador que lo ocupe
38570>>>            If (iEquipoID > 0) Begin
38572>>>                Get Create (RefClass(cSQLHandleManager)) to hoSQLMngr
38573>>>                Get SQLFileConnect of hoSQLMngr entrenador.File_number to hdbc
38574>>>                Get SQLOpen of hdbc to hstmt
38575>>>                Send SQLExecDirect of hstmt ("UPDATE entrenador SET EquipoID = NULL WHERE EquipoID = " + String(iEquipoID) + " AND ID <> " + String(iEntrenadorID))
38576>>>                Send SQLClose of hstmt
38577>>>                Send SQLDisconnect of hdbc
38578>>>                Send Destroy of hoSQLMngr
38579>>>            End
38579>>>>
38579>>>
38579>>>            // Ahora DataFlex guarda al nuevo entrenador sin conflicto de clave única
38579>>>            Forward Send Request_Save
38581>>>        End_Procedure
