39028>>>        tWebNavigateData NavigateData
39028>>>        tWebNavigateData NavigateData
39028>>>        Boolean bHasRecord
39028>>>        Handle hoDD
39028>>>
39028>>>        Get Server to hoDD
39029>>>        Get GetNavigateData to NavigateData
39030>>>        Get HasRecord of hoDD to bHasRecord
39031>>>
39031>>>        // let's hide all buttons and then Show the ones we want
39031>>>        WebSet pbRender of oEditBtn to False
39032>>>        WebSet pbRender of oSaveBtn to False
39033>>>        WebSet pbRender of oCancelChangesBtn to False
39034>>>        WebSet pbRender of oDeleteBtn to False
39035>>>
39035>>>        If (NavigateData.bReadOnly) Begin
39037>>>            WebSet pbRender of oEditBtn to True
39038>>>        End
39038>>>>
39038>>>        Else Begin
39039>>>            WebSet pbRender of oSaveBtn to True
39040>>>            WebSet pbRender of oCancelChangesBtn to True
39041>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39042>>>        End
39042>>>>
39042>>>    End_Procedure
