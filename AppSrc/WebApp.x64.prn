38069>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38072>>>        WebSet pbRender of oNewButton to True
38073>>>        WebSet pbRender of oDetailButton to True
38074>>>
38074>>>        Case Begin
38074>>>            Case (NavigateData.eNavigateType = nfFromParent)
38076>>>                // If from parent, this is a constrained drill down
38076>>>                // If Row select does main-zoom we don't need this
38076>>>                WebSet pbRender of oDetailButton to False
38077>>>                Case Break
38078>>>
38078>>>            Case (NavigateData.eNavigateType = nfFromChild)
38081>>>                // If from child, this is a probably a parent lookup from a Zoom
38081>>>                Case Break
38082>>>
38082>>>            Case (NavigateData.eNavigateType = nfFromMain)
38085>>>                // If from main, this is a probably a main-file lookup from a Zoom
38085>>>                WebSet pbRender of oDetailButton to False
38086>>>                Case Break
38087>>>
38087>>>            Case Else // must be nfUndefined
38087>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38087>>>                // If Row select does main-zoom we don't need this
38087>>>                WebSet pbRender of oDetailButton to False
38088>>>
38088>>>        Case End
38088>>>
38088>>>    End_Procedure
