38258>>>
38258>>>        // let's hide all buttons and then Show the ones we want
38258>>>        WebSet pbRender of oEditBtn to False
38259>>>        WebSet pbRender of oSaveBtn to False
38260>>>        WebSet pbRender of oCancelChangesBtn to False
38261>>>        WebSet pbRender of oDeleteBtn to False
38262>>>
38262>>>        If (NavigateData.bReadOnly) Begin
38264>>>            WebSet pbRender of oEditBtn to True
38265>>>        End
38265>>>>
38265>>>        Else Begin
38266>>>            WebSet pbRender of oSaveBtn to True
38267>>>            WebSet pbRender of oCancelChangesBtn to True
38268>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38269>>>        End
