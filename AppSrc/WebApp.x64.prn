38775>>>        Get HasRecord of hoDD to bHasRecord
38776>>>        Get HasRecord of oequipo_DD to bHasEquipo
38777>>>
38777>>>        // let's hide all buttons and then Show the ones we want
38777>>>        WebSet pbRender of oEditBtn to False
38778>>>        WebSet pbRender of oSaveBtn to False
38779>>>        WebSet pbRender of oCancelChangesBtn to False
38780>>>        WebSet pbRender of oDeleteBtn to False
38781>>>
38781>>>        If (NavigateData.bReadOnly) Begin
38783>>>            WebSet pbRender of oEditBtn to True
38784>>>        End
38784>>>>
38784>>>        Else Begin
38785>>>            WebSet pbRender of oSaveBtn to True
38786>>>            WebSet pbRender of oCancelChangesBtn to True
38787>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38788>>>        End
38788>>>>
38788>>>
38788>>>        // Mostrar u ocultar botones relacionados con el equipo según si tiene uno asignado
38788>>>        WebSet pbRender of oBtnDespedir to bHasEquipo
38789>>>        WebSet pbRender of oBtnVerEquipoEntrenador to bHasEquipo
38790>>>        WebSet pbRender of oBtnVerLigaEntrenador to bHasEquipo
38791>>>    End_Procedure
