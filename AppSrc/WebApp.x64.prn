37903>>>        Get GetNavigateData to NavigateData
37904>>>        Get HasRecord of hoDD to bHasRecord
37905>>>
37905>>>        // let's hide all buttons and then Show the ones we want
37905>>>        WebSet pbRender of oEditBtn to False
37906>>>        WebSet pbRender of oSaveBtn to False
37907>>>        WebSet pbRender of oCancelChangesBtn to False
37908>>>        WebSet pbRender of oDeleteBtn to False
37909>>>
37909>>>        If (NavigateData.bReadOnly) Begin
37911>>>            WebSet pbRender of oEditBtn to True
37912>>>        End
37912>>>>
37912>>>        Else Begin
37913>>>            WebSet pbRender of oSaveBtn to True
37914>>>            WebSet pbRender of oCancelChangesBtn to True
37915>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37916>>>        End
37916>>>>
37916>>>    End_Procedure
